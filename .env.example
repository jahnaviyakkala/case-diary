# --- Hindsight (memory) -------------------------------------------------
# Option A, Hindsight Cloud (recommended): https://ui.hindsight.vectorize.io
#   Connect -> Create API Key. Promo code MEMHACK99 in Billing gives $50 credit.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Option B, local Docker: set HINDSIGHT_URL=http://localhost:8888, leave the key empty,
#   and fill the HINDSIGHT_API_LLM_* lines below (used by docker-compose.yml).
HINDSIGHT_BANK=case-diary

# --- Agent LLM (Groq, OpenAI-compatible) -------------------------------
# https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Only for local Docker Hindsight ------------------------------------
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
